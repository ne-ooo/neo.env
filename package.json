{
  "name": "@lpm.dev/neo.env",
  "version": "1.0.0",
  "description": "Zero-dependency environment variable parser, loader, expander, and validator",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/config.js",
    "./dist/config.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "check": "lpm run typecheck && lpm run typecheck:tests && lpm run test:coverage && lpm run build && lpm run test:package",
    "package:check": "lpm run build && lpm publish --check --yes",
    "prepack": "lpm run build",
    "prepublishOnly": "lpm run security:audit && lpm run check",
    "security:audit": "lpm audit --level high --fail-on vuln",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/integration/package-exports.mjs",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.type-tests.json --noEmit"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "variables",
    "config",
    "settings",
    "typescript",
    "zero-dependency",
    "async",
    "validation",
    "interpolation",
    "esm",
    "tree-shakeable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.env"
  },
  "homepage": "https://github.com/ne-ooo/neo.env#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.env/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^17.3.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "lpm": ">=0.70.0"
  }
}
